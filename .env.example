# Copy to .env.local and fill in. Never commit .env.local.

# Where the Quarkus API (entrePatasETurnosAPI) runs. Read on the server only.
# Local: ./db.sh && ./mvnw quarkus:dev in the API repo.
API_BASE_URL=http://localhost:8080

# Google OAuth web client id. It MUST be the same id the API verifies
# (entrepataseturnos.auth.google.client-id / ENTREPATASETURNOS_AUTH_GOOGLE_CLIENT_ID),
# because the API checks the token's audience. Add this site's origin
# (e.g. http://localhost:3000) to the client's Authorized JavaScript origins in Google Cloud.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
